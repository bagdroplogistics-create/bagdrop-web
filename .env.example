# ─────────────────────────────────────────────────────────────
# BAGDROP — Environment Variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # NEVER expose to client

# ── Razorpay ──────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# Use TEST keys during development (prefix: rzp_test_)
# Use LIVE keys in production (prefix: rzp_live_)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID   # Same as above — safe to expose

# ── Google Maps ───────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs → Maps JavaScript API
# Restrict to: your domain + localhost
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000   # Change to https://bagdrop.co in production

# ── AviationStack (PNR / flight lookup) ──────────────────────
# Get from: https://aviationstack.com → Sign up → free tier gives 100 req/month
# Used by /api/flight-lookup to look up flights by IATA code + date.
# Without this key, the PNR lookup button is disabled in the booking flow.
AVIATIONSTACK_API_KEY=your_aviationstack_key_here

# ── Resend (transactional email) ──────────────────────────────
# Get from: https://resend.com/api-keys  (free tier: 100 emails/day)
# Verify sending domain at: https://resend.com/domains → add bagdrop.co
# Without this key, emails are skipped silently — bookings still work.
RESEND_API_KEY=your_resend_api_key_here

# ── Fast2SMS WhatsApp Business API ──────────────────────────────
# Get from: https://www.fast2sms.com/dashboard → WhatsApp Business → Dev API
# Phone Number ID: WhatsApp Manager → Numbers tab
# Message ID: WhatsApp Manager → Templates tab → your approved template
# Without these, WhatsApp acknowledgments are skipped silently — email still works.
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_WHATSAPP_PHONE_NUMBER_ID=your_fast2sms_phone_number_id_here
FAST2SMS_ACK_MESSAGE_ID=your_approved_inquiry_acknowledgment_message_id_here

# Booking lifecycle templates (lib/lifecycle-notifications.ts) — each fires
# once, when a booking's status first advances to the matching stage. Any
# one of these left unset just means that stage's WhatsApp send is skipped
# (email still goes out); nothing else breaks.
FAST2SMS_QUOTE_SENT_MESSAGE_ID=
FAST2SMS_QUOTE_ACCEPTED_MESSAGE_ID=
FAST2SMS_QUOTE_REJECTED_MESSAGE_ID=
FAST2SMS_PAYMENT_REQUEST_MESSAGE_ID=
FAST2SMS_PAYMENT_RECEIVED_MESSAGE_ID=
FAST2SMS_BOOKING_CONFIRMED_MESSAGE_ID=
FAST2SMS_BAGS_PICKED_UP_MESSAGE_ID=
FAST2SMS_BAGS_IN_TRANSIT_MESSAGE_ID=
FAST2SMS_OUT_FOR_DELIVERY_MESSAGE_ID=
FAST2SMS_BAGS_DELIVERED_MESSAGE_ID=

# Indemnity Bond flow templates (lib/indemnity-notifications.ts) — same
# additive, silently-skip-if-unset contract as above.
FAST2SMS_INDEMNITY_BOND_SENT_MESSAGE_ID=
FAST2SMS_INDEMNITY_OTP_VERIFIED_MESSAGE_ID=
FAST2SMS_INDEMNITY_SUBMITTED_MESSAGE_ID=
FAST2SMS_INDEMNITY_APPROVED_MESSAGE_ID=
FAST2SMS_INDEMNITY_RESUBMIT_MESSAGE_ID=

# Internal Ops WhatsApp pickup reminders (lib/ops-reminders.ts) — fires
# THREE tiers per confirmed booking (two_days_before, day_before, day_of),
# all using this ONE approved `ops_pickup_reminder` template (MESSAGE ID
# 27293, confirmed 12 variables: {{1}} Customer .. {{12}} Special
# Instructions). Sent only to settings.ops_reminder_whatsapp (default
# +91 63571 15711) — the template itself is internal-only ("Dear Bagdrop
# Team", Status/Driver fields), never sent to the customer.
FAST2SMS_OPS_REMINDER_MESSAGE_ID=

# Sales Follow-up & Reminder System (lib/sales-followup-reminders.ts) —
# internal-only, sent to the Ops WhatsApp number configured in Settings
# (sales_followup_whatsapp, default +91 63571 15711), never to a customer.
#   FAST2SMS_QUOTE_PENDING_MESSAGE_ID     — Fast2SMS message_id for the
#     APPROVED `quote_pending_reminder` template (WhatsApp Manager ->
#     Templates tab -> MESSAGE ID column — NOT the long numeric Template
#     ID shown on the same screen). Confirmed 5 positional variables (no
#     "Reminder Stage"): {{1}} Customer, {{2}} Inquiry ID, {{3}} Route,
#     {{4}} Inquiry Date, {{5}} Mobile. Fires 2h after an inquiry is
#     created with no quote_number yet — see supabase/migrations/
#     20260812_quote_pending_2h.sql.
#   FAST2SMS_SALES_FOLLOWUP_MESSAGE_ID    — Fast2SMS message_id for the
#     APPROVED `sales_followup_reminder` template (same MESSAGE ID vs
#     Template ID distinction as above). Confirmed 5 positional variables
#     (no "Reminder Stage"): {{1}} Customer, {{2}} Inquiry ID,
#     {{3}} Quote Date, {{4}} Route, {{5}} Mobile. Fires 24h (default —
#     sales_followup_response_reminder_hours setting, unchanged) after a
#     quote is sent (quote_date) with no customer_responded_at yet.
# Left unset: the WhatsApp send for that reminder silently fails (logged as
# 'failed' on the lead_followups row) — nothing else in the app breaks.
FAST2SMS_QUOTE_PENDING_MESSAGE_ID=
FAST2SMS_SALES_FOLLOWUP_MESSAGE_ID=

# New Inquiry — internal Ops WhatsApp ping (lib/new-inquiry-notification.ts)
# fired alongside the existing admin email (lib/email.ts's
# sendInquiryNotification) every time a new lead/inquiry is created —
# admin New Quote form, website/app booking form, Skybird partner
# dashboard, and admin "+ New Quote". Sent to the Ops WhatsApp number
# configured in Settings (new_inquiry_whatsapp, default +91 63571 15711),
# never to the customer. Approved template (Category: Utility) needs
# exactly 7 positional variables, in this exact order:
#   {{1}} Inquiry ID, {{2}} Customer, {{3}} Mobile, {{4}} Email,
#   {{5}} Pickup, {{6}} Delivery, {{7}} Pickup Date
# Left unset: this WhatsApp send silently no-ops (logged only) — nothing
# else breaks; the admin email still goes out as before.
FAST2SMS_NEW_INQUIRY_MESSAGE_ID=

# Shared secret checked by every app/api/cron/* route (send-ops-reminders,
# send-lead-followups, send-driver-details) — set this, then point an
# external free scheduler (cron-job.org / EasyCron) at each route every
# 10-15 min with header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=choose_a_strong_random_value_here

# ── Skybird Partner Dashboard ────────────────────────────────────
# Shared access key for the whole Skybird USA team to log in at /skybird/login.
# Separate from ADMIN_SECRET_KEY/STAFF_SECRET_KEY on purpose — this key only
# unlocks the Skybird-scoped dashboard (source='skybird' leads), never the
# BagDrop Admin Dashboard.
SKYBIRD_SECRET_KEY=choose_a_strong_shared_key_here
